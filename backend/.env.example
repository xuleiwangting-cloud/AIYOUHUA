# Supabase 项目配置
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase service/secret key（仅后端使用，绝不要暴露到前端）
SUPABASE_SERVICE_KEY=sb_secret_xxx_replace_me

# JWT 签名密钥（自定义一段足够长的随机字符串）
JWT_SECRET=please_change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# 服务端口（Render 会自动注入 PORT，本地默认 3001）
PORT=3001
# 允许的前端来源，多个地址用英文逗号分隔
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://YOUR_GITHUB_USERNAME.github.io
